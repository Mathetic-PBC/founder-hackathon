# Substring of the USB device name; both directions must match by name.
MIC_DEVICE=JV801
SPEAKER_DEVICE=JV801
# Hardware volume is reapplied before playback because PipeWire resets it at boot.
ALSA_CARD=JV801
HARDWARE_VOLUME=75

# Higher score / lower threshold makes HEY BART easier to trigger.
KEYWORDS_SCORE=1.5
KEYWORDS_THRESHOLD=0.15

# RMS of normalized [-1, 1] audio. Tune for the room and mic distance.
VAD_THRESHOLD=0.015
SILENCE_SECONDS=1.5
MAX_RECORD_SECONDS=15
SPEECH_START_TIMEOUT=5
PRE_ROLL_SECONDS=0.6
CHIME_VOLUME=0.15

# Leave empty to save recordings locally without making any requests.
TURN_URL=
HTTP_ATTEMPTS=3
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=30
