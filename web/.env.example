OPENAI_API_KEY=sk-...
SUPABASE_URL=https://<project-ref>.supabase.co
# New-style Supabase secret key (sb_secret_...). Server only.
SUPABASE_SECRET_KEY=sb_secret_...
# Shared secret the Pi sends as the x-bart-token header
BART_TOKEN=change-me

# Optional overrides
# VISION_MODEL=gpt-6.1-terra

# iMessage through Photon (Beta/2.0): a project API key (pho_sk_...), its project ID (pho_prj_...)
# and the shared line's number
PHOTON_API_KEY=pho_sk_...
PHOTON_PROJECT_ID=pho_prj_...
PHOTON_AGENT_HANDLE=+1...
# BART_TIMEZONE=America/Los_Angeles
